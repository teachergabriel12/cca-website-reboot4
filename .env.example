# SMTP — envio automático de e-mails do portal de contato
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_USER=contato@cca-engenharia.com.br
SMTP_PASS=sua_senha_ou_app_password
SMTP_FROM="CCA Governança Técnica <contato@cca-engenharia.com.br>"
LEADS_TO_EMAIL=contato@cca-engenharia.com.br

